APP_NAME="MAN 1 Lampung Selatan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mansalase_modern
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@mansalase.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Kemenag SSO (OAuth 2.0 / OpenID Connect)
# Aktifkan setelah aplikasi menerima Client ID, Client Secret, dan endpoint resmi.
KEMENAG_SSO_ENABLED=false
KEMENAG_SSO_LABEL="Masuk dengan SSO Kemenag"
KEMENAG_SSO_CLIENT_ID=
KEMENAG_SSO_CLIENT_SECRET=
KEMENAG_SSO_REDIRECT_URI="${APP_URL}/admin/sso/kemenag/callback"
KEMENAG_SSO_AUTHORIZATION_URL=
KEMENAG_SSO_TOKEN_URL=
KEMENAG_SSO_USERINFO_URL=
KEMENAG_SSO_LOGOUT_URL=
KEMENAG_SSO_SCOPES="openid,profile,email"
KEMENAG_SSO_TOKEN_AUTH_METHOD=client_secret_post
KEMENAG_SSO_AUTO_PROVISION=true
KEMENAG_SSO_DEFAULT_ROLE=author
KEMENAG_SSO_ALLOWED_EMAIL_DOMAINS=
KEMENAG_SSO_CLAIM_ID=sub
KEMENAG_SSO_CLAIM_NAME=name
KEMENAG_SSO_CLAIM_EMAIL=email
KEMENAG_SSO_CLAIM_NIP=nip
KEMENAG_SSO_CLAIM_UNIT=unit_name
KEMENAG_SSO_CLAIM_AVATAR=picture
KEMENAG_SSO_TIMEOUT=15
KEMENAG_SSO_VERIFY_SSL=true
